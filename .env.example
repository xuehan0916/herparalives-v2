# Alibaba Bailian (server only). Used by "我的平行人生" generation.
# Inject via .env.local (gitignored) or the hosting dashboard — never commit it.
DASHSCOPE_API_KEY=
QWEN_STORY_MODEL=qwen-plus
QWEN_STRUCTURED_MODEL=qwen-plus
# Optional: custom OpenAI-compatible endpoint for local mock testing.
LLM_BASE_URL=

# Optional: Supabase Auth with an SMS provider enabled in its dashboard.
# Both values stay on the server. With these unset, the app offers guest play.
SUPABASE_URL=
SUPABASE_ANON_KEY=
